{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": [
      "ES2023",
      "DOM"
    ],
    "jsx": "react-jsx",
    "experimentalDecorators": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "apps/*/src/**/*.ts",
    "spikes/**/*.ts",
    "*.ts",
    "*.js"
  ]
}
