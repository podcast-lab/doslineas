{
  "name": "podcast-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/graphics/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx --env-file-if-exists=.env apps/cli/src/index.ts",
    "spike": "tsx spikes/switching-render.ts",
    "studio": "pnpm --filter @doslineas/graphics studio"
  },
  "devDependencies": {
    "@doslineas/analysis": "workspace:*",
    "@doslineas/core": "workspace:*",
    "@doslineas/graphics": "workspace:*",
    "@doslineas/media": "workspace:*",
    "@doslineas/pipeline": "workspace:*",
    "@doslineas/providers": "workspace:*",
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.7.5",
    "eslint": "^9.12.0",
    "fast-xml-parser": "^5.11.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "vitest": "^2.1.2"
  }
}
